# Copy to .env and fill in what you need. Nothing here is required for the
# non-LLM steps (combine, dedupe, the adjudication UI).

# --- AWS Bedrock (LLM raters) ---
# Named profile from ~/.aws/config; omit to use boto3's default credential chain.
AWS_PROFILE=
# Bedrock batch inference (scripts/batch/): bucket for input/output, and the
# IAM role Bedrock assumes to read and write it.
BEDROCK_BATCH_BUCKET=
BEDROCK_BATCH_ROLE_ARN=

# --- Contact address ---
# Sent to OpenAlex, Unpaywall and Crossref so they can reach you about your traffic.
CONTACT_EMAIL=

# --- Abstract and full-text sources (all optional) ---
SEMANTIC_SCHOLAR_API_KEY=
ELSEVIER_API_KEY=
ELSEVIER_INSTTOKEN=
SPRINGER_META_API_KEY=
SPRINGER_OA_API_KEY=

# --- Institutional access through OpenAthens (optional) ---
# Redirector base for your institution, e.g. https://go.openathens.net/redirector/<domain>
OPENATHENS_REDIRECTOR=
OPENATHENS_LOGIN_URL=https://my.openathens.net/
# Persistent browser profile so the login survives between runs.
# CHROME_PROFILE_DIR=

# --- Manual full-text ingestion ---
# Folder holding manually downloaded PDFs / HTML files (scripts/fulltext/ingest_manual_pdfs.py).
MANUAL_PDF_DIR=

# --- Citation snowballing ---
# scripts/snowball/scrape_citations.py screens seed reviews with an OpenAI model.
OPENAI_API_KEY=
