.DS_Store
.claude/worktrees

# logs
*.log

# extracted publisher full text (copyrighted) — never commit
full_text/
full_text_snowball/
manual_fulltext/

# local secrets / backups / editor lock files
*.bak-deadkey
.env.bak*
*backup*.csv
*_pre_*.csv
~$*.xlsx

# large derived datasets — regenerable from the pipeline; kept out of git
search-results-from-database/*.csv
search-results-from-database/combined/
search-results-from-database/children/
search-results-from-database/snowball/
search-results-from-database/database-csvs/
